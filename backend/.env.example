APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///../data/cloudtool.db
CORS_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
CLOUD_API_BASE_URL=https://console.viettelcloud.vn
CLOUD_API_ALLOWED_HOSTS=["console.viettelcloud.vn","vnc.viettelcloud.vn"]
CLOUD_CONCURRENCY_LIMIT=5
CLOUD_API_TIMEOUT_SECONDS=30
CLOUD_API_CONNECT_TIMEOUT_SECONDS=10
CLOUD_API_RETRY_COUNT=2
TOKEN_MAX_IDLE_SECONDS=1800
DEBUG_CLOUD_APPROVAL_MODE=false
UPLOAD_MAX_BYTES=5242880
EXPORT_MAX_ROWS=50000
LOG_RETENTION_DAYS=90
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=cloudtool_session
PASSWORD_PROFILE_ENCRYPTION_KEY=
MONITOR_REGION_MAPPING={}
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
