FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# The Teleport integration runs tsh on the Linux backend host.  Keep one
# pinned Linux binary in the image rather than relying on a Windows path that
# may have been stored in a database before migration.
ARG TELEPORT_VERSION=16.5.17
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "https://cdn.teleport.dev/teleport-v${TELEPORT_VERSION}-linux-amd64-bin.tar.gz" -o /tmp/teleport.tar.gz \
    && tar -xzf /tmp/teleport.tar.gz -C /tmp \
    && install -m 0755 /tmp/teleport/tsh /usr/local/bin/tsh \
    && rm -rf /tmp/teleport /tmp/teleport.tar.gz /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
COPY alembic.ini ./
COPY migrations ./migrations
RUN pip install --no-cache-dir . \
    && useradd --system --uid 10001 cloudtool

USER cloudtool
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
