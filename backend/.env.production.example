# Copy to /srv/cloud-tool/env/backend.env on the Web VM. Do not commit real secrets.
APP_ENV=production
DATABASE_URL=sqlite+aiosqlite:////data/cloudtool-runtime.db
TELEMETRY_DATABASE_URL=sqlite+aiosqlite:////data/cloudtool-telemetry.db
CORS_ORIGINS=["https://cloudtool.example.com"]
TRUSTED_HOSTS=["cloudtool.example.com"]
CLOUD_API_BASE_URL=https://console.viettelcloud.vn
CLOUD_API_ALLOWED_HOSTS=["console.viettelcloud.vn","vnc.viettelcloud.vn"]
PASSWORD_PROFILE_ENCRYPTION_KEY=replace-with-a-fernet-key
CLOUD_AUTHORIZATION_ENCRYPTION_KEY=replace-with-a-fernet-key
AGENT_SERVICE_BACKEND_KEY=replace-with-a-shared-random-secret
