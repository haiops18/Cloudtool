APP_ENV=development
HOST=127.0.0.1
PORT=8005
CLOUDTOOL_BACKEND_URL=http://127.0.0.1:8003/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:5000","http://127.0.0.1:5000","http://[::1]:5000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
# Optional. If empty, agent-service runs in evidence-only mode.
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-5.4
# Default is Codex app-server. Codex CLI must be installed and authenticated on this machine.
AGENT_LLM_PROVIDER=codex_app_server
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_WORKDIR=.
# Browser chat uses a separate folder below this root for every CloudTool project.
CODEX_PROJECT_WORKSPACE_ROOT=./data/codex-projects
# The CloudTool repository root. Only frontend/src, backend/app and agent-service/app are exposed read-only.
CODEX_SOURCE_ROOT=..
CODEX_TIMEOUT_SECONDS=120
# Optional. Enables POST /api/v1/external/chat for clients sending this key via
# X-Agent-API-Key or Authorization: Bearer <key>. Keep empty to disable it.
AGENT_EXTERNAL_API_KEY=
AGENT_SERVICE_BACKEND_KEY=
