# Copy to /srv/cloud-tool/env/agent-service.env on the Web VM. Do not commit secrets.
APP_ENV=production
HOST=0.0.0.0
PORT=8004
CLOUDTOOL_BACKEND_URL=http://backend:8000/api/v1
CORS_ORIGINS=["https://cloudtool.example.com"]
TRUSTED_HOSTS=["cloudtool.example.com","backend"]
AGENT_SERVICE_BACKEND_KEY=replace-with-the-backend-shared-secret
