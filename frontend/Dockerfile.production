FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build \
    && find dist -type f -name '*.js' -exec sed -i 's|http://localhost:8000/api/v1|/api/v1|g; s|http://localhost:8003/api/v1|/api/v1|g; s|http://localhost:8005/api/v1|/agent-api/api/v1|g' {} +

# Runs as the unprivileged nginx user, so it is compatible with Kubernetes'
# restricted security context without requiring Linux capabilities at startup.
FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
